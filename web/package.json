    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "24.19.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  }
}
