# Copy to ~/.config/contrail/env and adjust. Read by start.sh; no secrets are needed.
HOST=127.0.0.1
PORT=8100
# Leave empty: Contrail is served from the root of contrail.maciejzielinski.dev (see nginx-server.conf).
BASE_PATH=
DATA_DIR=/data/data/com.termux/files/home/contrail-data
# nginx compresses responses
GZIP=0
# Be a polite client of the public feed: at most this many upstream requests per second (adapts downwards on HTTP 429)
UPSTREAM_BUDGET_RPS=0.15
# Background coverage plan: name:south,north,west,east:priority:interval_s;...  Empty means the defaults
# (Europe, then the US, then a few hubs: Dubai, Singapore, Hong Kong, Shanghai, Beijing, Tokyo, Delhi, Mumbai,
# Sao Paulo, Johannesburg, Sydney); "off" disables prefetching.
PREFETCH_REGIONS=
PREFETCH_ALWAYS=1
# Shown to upstream services in the User-Agent so they can reach you
USER_AGENT_CONTACT=https://github.com/MaciejZiel/contrail
